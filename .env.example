# Polymarket wallet private key (no 0x prefix)
POLYMARKET_PRIVATE_KEY=your_private_key_here

# Polymarket CLOB API credentials (derived from private key on first run)
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# Anthropic API key for Claude AI analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Set to False to place real orders
DRY_RUN=True
